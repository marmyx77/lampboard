# SwiftPM build products. 310 MB, regenerated by `swift build`.
.build/
.swiftpm/
Package.resolved

# The signed app bundle, produced by Scripts/build-app.sh.
dist/

# macOS
.DS_Store

# Anything the app writes at runtime, in case someone points
# LAMPBOARD_HOME at the checkout while testing.
.lampboard/

# Compiled Python from Scripts/. A build artefact: tracked, it changes on
# every run of make-icon.py and adds noise to every diff.
__pycache__/
*.pyc

# Working plans and the audits they answer. `docs/README.md` has always said a
# plan lives here until its decision has landed in 04-decisions.md and its story
# in WORKLOG.md, and then leaves. They never left, so they are kept out of the
# repository instead: what survives a plan is the decision it produced, and that
# has a home of its own.
docs/plans/

# Where the test Mac is (Scripts/run-remote.sh). Host names and accounts are
# personal and this repository is public.
.env.machines
