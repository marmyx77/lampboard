# Takes the hooks' port for lampd as soon as it is free (W5, §2.3 point 3, E1):
# when the Mac's tunnel moves to the next port, or after lampd release is
# undone. Every second the port waits is a second of hooks the node does not
# hear, so lampd-socket-retry.timer runs this every two seconds; it does nothing
# while lampd.socket is up, while the port is taken, or after `lampd release`.
# lampd started before the socket holds no hooks' port, so it is restarted once
# the socket is up (its phones reconnect and lose nothing: v1 resumes by number).

[Unit]
Description=LampBoard (lampd): take the hooks' port when it is free
ConditionPathExists=!%h/.local/state/lampd/hooks-released

[Service]
Type=oneshot
ExecStart=/bin/sh -c 'systemctl --user is-active -q lampd.socket && exit 0; ss -Htln "sport = :@HOOK_PORT@" 2>/dev/null | grep -q . && exit 0; systemctl --user start lampd.socket && systemctl --user try-restart lampd.service'
